{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyKey",
  "version": "0.1.0",
  "identifier": "io.github.horknfbr.rustykey",
  "build": {
    "frontendDist": "../crates/rustykey-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../crates/rustykey-ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../crates/rustykey-ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustyKey",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 400,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2RTc4OUQ3M0RDOUJDN0EKUldSNnZNazkxNG5ucGsvdUFFaTd5cm5QdXhxYWVHa0hzalZ5YWtNT0dGSUtzVTY1R0U3NmNxWWMK",
      "endpoints": [
        "https://github.com/horknfbr/rustykey-app/releases/latest/download/latest.json"
      ]
    }
  }
}
