{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyKey",
  "version": "0.1.0",
  "identifier": "io.github.horknfbr.rustykey",
  "build": {
    "frontendDist": "../crates/rustykey-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../crates/rustykey-ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../crates/rustykey-ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustyKey",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 400,
        "center": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
